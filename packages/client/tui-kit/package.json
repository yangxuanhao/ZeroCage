{
  "name": "@deepseek-ai/dsh-tui-kit",
  "description": "ZeroCage terminal rendering kit: pi-tui adapters, transcript and tool cards, diff styling, status bar, and terminal prompts",
  "version": "0.2.2-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
