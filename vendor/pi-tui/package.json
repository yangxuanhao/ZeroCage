{
  "name": "@deepseek-ai/pi-tui",
  "description": "Vendored terminal UI library (differential rendering, editor, overlays) from @earendil-works/pi-tui, used by the ZeroCage TUI host",
  "version": "0.2.2-rc.3",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src",
    "native"
  ],
  "author": "Mario Zechner",
  "license": "MIT",
  "dependencies": {
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.11",
    "marked-cjk-friendly": "0.1.2"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
